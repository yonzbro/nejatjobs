# Bu dosyayı kopyalayıp değerleri doldurun. Gerçek değerler asla commit edilmez.
# Supabase → Project Settings → API Keys
SUPABASE_URL=https://<proje-id>.supabase.co
# sb_publishable_... — herkese açık olabilir (frontend + RLS testleri); güvenliği RLS sağlar
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... — yalnızca scraper / GitHub Actions; frontend'e (NEXT_PUBLIC_) ASLA konmaz
SUPABASE_SECRET_KEY=
